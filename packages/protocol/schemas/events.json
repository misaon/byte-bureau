            "policy": {
              "type": "object",
              "properties": {
                "onTimeout": {
                  "type": "string",
                  "enum": [
                    "wait",
                    "recommended",
                    "deny"
                  ]
                },
                "timeout": {
                  "type": "string"
                }
              },
              "required": [
                "onTimeout",
                "timeout"
              ],
              "additionalProperties": false
            },
            "recommendationSource": {
              "type": "string",
              "enum": [
                "agent",
                "policy",
                "none"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "answered",
                "expired",
                "cancelled"
              ]
