                        "description": {
                          "type": "string"
                        },
                        "recommended": {
                          "type": "boolean"
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "file",
                                  "test",
                                  "doc",
                                  "ticket",
                                  "rule"
                                ]
                              },
                              "ref": {
                                "type": "string"
                              },
                              "excerpt": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "kind",
                              "ref"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "recommended",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "multiSelect": {
                    "type": "boolean"
                  },
                  "allowOther": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "header",
                  "prompt",
                  "options",
                  "multiSelect",
                  "allowOther"
                ],
                "additionalProperties": false
              }
