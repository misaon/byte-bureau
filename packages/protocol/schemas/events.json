            "kind": {
              "type": "string",
              "enum": [
                "question",
                "permission"
              ]
            },
            "title": {
              "type": "string"
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "header": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
