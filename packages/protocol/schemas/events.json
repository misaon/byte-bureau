            "id",
            "sessionId",
            "turnId",
            "kind",
            "title",
            "questions",
            "policy",
            "recommendationSource",
            "status",
            "createdAt",
            "deadlineAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ask"
      ],
      "additionalProperties": false
