      "type": "object",
      "properties": {
        "askId": {
          "type": "string",
          "title": "UUIDv7",
          "description": "Time-ordered UUID (v7)"
        },
        "answer": {
          "type": "object",
          "properties": {
            "selected": {
              "anyOf": [
                {
                  "type": "array",
