{
  "name": "bytebureau",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "bin": {
    "bytebureau": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run ../../scripts/build-binaries.ts --host --outdir dist"
  },
  "dependencies": {
    "@bytebureau/i18n": "workspace:*",
    "@bytebureau/kernel": "workspace:*",
    "@bytebureau/protocol": "workspace:*",
    "@clack/prompts": "1.8.1",
    "citty": "0.2.2",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@bytebureau/tsconfig": "workspace:*"
  }
}
